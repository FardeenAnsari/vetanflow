  "cards": [
    {
      "dot": "cyan",
      "title": "Primary Runtime Path",
      "items": [
        "User actions travel through the React SPA and same-origin Vercel routing",
        "The Express pipeline verifies the session before domain modules execute",
        "Payroll modules read or mutate organization-scoped state and append audit evidence"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust And Access Controls",
      "items": [
        "The browser receives only the Supabase publishable key; the service-role key stays server-side",
        "Roles are resolved from user_roles and sensitive routes enforce role-specific decisions",
        "Postgres RLS and private Storage buckets provide a second authorization boundary"
      ]
    },
    {
      "dot": "emerald",
      "title": "Supporting Runtime Detail",
      "items": [
        "Domain modules cover employees, invitations, HR, leave, attendance, payroll, payslips, ID cards, and exports",
        "Zod validates runtime configuration and request payloads; Helmet, CORS, body limits, and rate limits harden HTTP",
        "Sentry SDKs are integrated for browser and API telemetry but remain inactive until DSNs are configured"
      ]
    }
  ]
